# Vocação de Pai — variáveis de ambiente (lista fechada: CLAUDE.md §13 / doc 02 §8)
# Copie para .env (local) e cadastre na Vercel (Production + Preview). Nunca commitar .env.

# Supabase (projeto vocacaodepai, região sa-east-1) — públicas, vão para o bundle
VITE_SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_KEY>
# Só no servidor (server functions e rotas de API). Nunca em variável VITE_/PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Site
PUBLIC_SITE_URL=https://vocacaodepai.com.br
PUBLIC_AMAZON_TAG=vocacaodepai-20
PUBLIC_GA4_ID=

# E-mail transacional (newsletter double opt-in, contato, avisos)
RESEND_API_KEY=

# Imagens (edge function stock-photos / editor)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Mercado do pai (opcional; sem token usa só Banco Central e AwesomeAPI)
BRAPI_TOKEN=

# Login com Google (Área do Pai, Fase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo único dos crons e integrações (/api/market/refresh, /api/cron/*, /api/newsletter/weekly, /api/hub/metrics)
CRON_SECRET=

# Cloudflare Turnstile (newsletter, contato, cadastro). Sem chave, os formulários degradam sem captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
